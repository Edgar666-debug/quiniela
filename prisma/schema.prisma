generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  emailVerified    Boolean?           @default(false)
  image            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  accounts         Account[]
  invitesCreated   Invite[]           @relation("InviteCreatedBy")
  matchesCreated   Match[]            @relation("MatchCreatedBy")
  matchdaysCreated Matchday[]         @relation("MatchdayCreatedBy")
  passkeys         Passkey[]
  picks            Pick[]
  sessions         Session[]
  standings        Standing[]
  tournamentsOwned Tournament[]       @relation("TournamentOwner")
  memberships      TournamentMember[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Passkey {
  id           String   @id @default(cuid())
  name         String?
  publicKey    String
  credentialID String   @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Tournament {
  id               String             @id @default(cuid())
  name             String
  logoUrl          String?
  status           TournamentStatus   @default(ACTIVE)
  scope            TournamentScope    @default(OPEN)
  externalLeagueId Int?
  leagueName       String?
  leagueSeason     Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ownerId          String
  invites   Invite[]
  matchdays Matchday[]
  standings Standing[]
  syncRuns  SyncRun[]
  owner     User               @relation("TournamentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TournamentMember[]
}

model TournamentMember {
  id           String     @id @default(cuid())
  role         MemberRole @default(PLAYER)
  joinedAt     DateTime   @default(now())
  tournamentId String
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Invite {
  id              String     @id @default(cuid())
  token           String     @unique
  maxUses         Int        @default(1)
  uses            Int        @default(0)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  tournamentId    String
  createdByUserId String?
  recipientEmail  String?
  createdBy       User?      @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([createdByUserId])
}

model Matchday {
  id              String     @id @default(cuid())
  number          Int
  closesAtUtc     DateTime
  createdAt       DateTime   @default(now())
  tournamentId    String
  createdByUserId String?
  matches         Match[]
  createdBy       User?      @relation("MatchdayCreatedBy", fields: [createdByUserId], references: [id])
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, number])
  @@index([createdByUserId])
}

model Match {
  id                String   @id @default(cuid())
  externalFixtureId Int?     @unique
  externalLeagueId  Int?
  leagueName        String?
  leagueSeason      Int?
  startsAtUtc       DateTime
  homeTeam          String
  awayTeam          String
  statusShort       String   @default("NS")
  scoreHome         Int?
  scoreAway         Int?
  updatedAt         DateTime @updatedAt
  matchdayId        String
  syncMisses        Int      @default(0)
  homeLogoUrl       String?
  awayLogoUrl       String?
  createdByUserId   String?
  createdBy         User?    @relation("MatchCreatedBy", fields: [createdByUserId], references: [id])
  matchday          Matchday @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  picks             Pick[]

  @@index([createdByUserId])
}

model Pick {
  id        String      @id @default(cuid())
  outcome   PickOutcome
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  matchId   String
  userId    String
  match     Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Standing {
  id           String     @id @default(cuid())
  points       Int        @default(0)
  updatedAt    DateTime   @updatedAt
  tournamentId String
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model SyncRun {
  id                    String     @id @default(cuid())
  ranAtUtc              DateTime   @default(now())
  status                String     @default("SUCCESS")
  message               String?
  checkedMatches        Int        @default(0)
  updatedMatches        Int        @default(0)
  standingsRecalculated Boolean    @default(false)
  tournamentId          String
  tournament            Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId, ranAtUtc])
}

enum MemberRole {
  OWNER
  ORGANIZER
  PLAYER
}

enum PickOutcome {
  HOME
  DRAW
  AWAY
}

enum TournamentStatus {
  ACTIVE
  FINISHED
  ARCHIVED
}

enum TournamentScope {
  OPEN
  SINGLE_LEAGUE
}
